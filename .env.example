# Matches docker-compose.yml. Override to point at another Postgres.
DATABASE_URL=postgresql://dep_watch:dep_watch@localhost:5433/dep_watch

# Langfuse Cloud project keys (Settings -> API keys). Needed for `eval upload` and tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# The LLM system: any OpenAI-compatible chat server (LM Studio, vLLM, Ollama, llama.cpp), or
# Amazon Bedrock. Without DEP_WATCH_LLM_MODEL no system is registered and /check and /scan
# return 503.
DEP_WATCH_LLM_MODEL=qwen/qwen3-4b-2507
# openai (default) or bedrock. Bedrock takes credentials from the AWS chain (AWS_PROFILE on a
# laptop, the instance role on EC2) and the region from AWS_REGION; BASE_URL and API_KEY are
# ignored, and DEP_WATCH_LLM_MODEL is a Bedrock model or inference profile id.
# DEP_WATCH_LLM_PROVIDER=openai
# DEP_WATCH_LLM_BASE_URL=http://localhost:1234/v1
# DEP_WATCH_LLM_API_KEY=not-needed
# DEP_WATCH_LLM_TIMEOUT=600
# text: parse JSON out of the answer (default; reasoning models need it). json_schema: the server
# constrains decoding, which makes reasoning models like gemma-4 skip thinking and return nothing.
# DEP_WATCH_LLM_OUTPUT=text
# OpenAI reasoning_effort, unset by default. none turns thinking off: Qwen3.5 otherwise thinks
# until DEP_WATCH_LLM_MAX_TOKENS runs out and answers nothing.
# DEP_WATCH_LLM_REASONING_EFFORT=none
# Registry name, used in run names and Langfuse. Default: the model id without its publisher.
# DEP_WATCH_LLM_SYSTEM=qwen3-4b-2507
# Systems to register for the model, one per variant: zeroshot, fewshot, cot, hybrid, direct.
# DEP_WATCH_LLM_VARIANTS=zeroshot
# The model's release date, for the contamination split, if eval/contamination.py doesn't list it.
# DEP_WATCH_LLM_RELEASE_DATE=2025-08-05

# Hybrid retrieval (the hybrid variant): an OpenAI-compatible embeddings endpoint.
# DEP_WATCH_EMBED_MODEL=text-embedding-qwen3-embedding-0.6b
# DEP_WATCH_EMBED_BASE_URL=http://localhost:1234/v1
# Issues longer than this many characters are read through retrieval.
# DEP_WATCH_RETRIEVAL_BUDGET=6000

# Judge for faithfulness scoring; never the model under test.
# DEP_WATCH_JUDGE_MODEL=qwen/qwen3.5-9b
# DEP_WATCH_JUDGE_REASONING_EFFORT=none

# Web API. Defaults shown.
# DEP_WATCH_HOST=127.0.0.1
# DEP_WATCH_PORT=8000
# Comma-separated origins allowed to call the API from a browser (the frontend dev server).
# DEP_WATCH_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Regression-gate baselines (committed).
# DEP_WATCH_BASELINES_DIR=eval/baselines
# Set to 0 to skip `alembic upgrade head` on startup.
# DEP_WATCH_MIGRATE_ON_STARTUP=1
