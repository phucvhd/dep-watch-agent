# Matches docker-compose.yml. Override to point at another Postgres.
DATABASE_URL=postgresql://dep_watch:dep_watch@localhost:5433/dep_watch

# Langfuse Cloud project keys (Settings -> API keys). Needed for `eval upload` and tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Web API. Defaults shown.
# DEP_WATCH_HOST=127.0.0.1
# DEP_WATCH_PORT=8000
# Comma-separated origins allowed to call the API from a browser (the frontend dev server).
# DEP_WATCH_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to 0 to skip `alembic upgrade head` on startup.
# DEP_WATCH_MIGRATE_ON_STARTUP=1
