# Matches docker-compose.yml. Override to point at another Postgres.
DATABASE_URL=postgresql://dep_watch:dep_watch@localhost:5433/dep_watch

# Langfuse Cloud project keys (Settings -> API keys). Needed for `eval upload` and tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# The LLM system: any OpenAI-compatible chat server (LM Studio, vLLM, Ollama, llama.cpp).
# Without DEP_WATCH_LLM_MODEL no system is registered and /check and /scan return 503.
DEP_WATCH_LLM_MODEL=google/gemma-4-e4b
# DEP_WATCH_LLM_BASE_URL=http://localhost:1234/v1
# DEP_WATCH_LLM_API_KEY=not-needed
# DEP_WATCH_LLM_TIMEOUT=600
# text: parse JSON out of the answer (default; reasoning models need it). json_schema: the server
# constrains decoding, which makes reasoning models like gemma-4 skip thinking and return nothing.
# DEP_WATCH_LLM_OUTPUT=text
# Registry name, used in run names and Langfuse. Default: the model id without its publisher.
# DEP_WATCH_LLM_SYSTEM=gemma-4-e4b

# Web API. Defaults shown.
# DEP_WATCH_HOST=127.0.0.1
# DEP_WATCH_PORT=8000
# Comma-separated origins allowed to call the API from a browser (the frontend dev server).
# DEP_WATCH_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to 0 to skip `alembic upgrade head` on startup.
# DEP_WATCH_MIGRATE_ON_STARTUP=1
